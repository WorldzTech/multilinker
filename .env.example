# --- PostgreSQL (external database, no local db container) ---
POSTGRES_DB=multilink
POSTGRES_USER=multilink
POSTGRES_PASSWORD=multilink
POSTGRES_HOST=your-db-host
POSTGRES_PORT=5432

# --- Django backend ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
# Add production hostnames here (backend is served on api.kidsr.ru)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,api.kidsr.ru
CORS_ALLOW_ALL_ORIGINS=True
# If you set CORS_ALLOW_ALL_ORIGINS=False, restrict to the frontend origin(s) instead:
# CORS_ALLOWED_ORIGINS=https://kidsr.ru,https://www.kidsr.ru
# Required for the Django admin over HTTPS (e.g. https://api.kidsr.ru/admin/)
DJANGO_CSRF_TRUSTED_ORIGINS=https://kidsr.ru,https://www.kidsr.ru,https://api.kidsr.ru
# Set to True when running behind a reverse proxy that terminates TLS
DJANGO_USE_X_FORWARDED_PROTO=False

# --- Next.js frontend ---
# Base URL used by the browser (client-side requests, e.g. click tracking)
# Local dev: http://localhost:8000/api/v1
# Production: https://api.kidsr.ru/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Base URL used by the Next.js server for SSR requests inside the docker network
INTERNAL_API_URL=http://backend:8000/api/v1
